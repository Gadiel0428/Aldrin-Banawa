# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_CENTRAL_SERVER_URL: The centralized server URL used by all installed clients (PC-1, PC-2, mobile, desktop)
VITE_CENTRAL_SERVER_URL="http://192.168.20.214:3000"

# GITHUB_REPO: Required on Render so the server can fetch the latest GitHub release tag (e.g. "owner/repo" like "aldrin0422/juwei-wms")
GITHUB_REPO="owner/repo"

# GITHUB_TOKEN: Optional for public repos, recommended to avoid rate limits or required for private repos
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
