# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_CENTRAL_SERVER_URL: The centralized cloud server URL used by all installed clients (PC-1, PC-2, mobile, desktop)
VITE_CENTRAL_SERVER_URL="https://ais-pre-vmhtsbs5lyqg4e3o5qf35l-327128958892.asia-southeast1.run.app"
